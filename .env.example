# Server-only configuration. Copy to .env and replace required placeholders.
# Never prefix credentials with VITE_ or paste wallet seed/private keys here.
DESK_MODE=OBSERVE
DESK_HOST=127.0.0.1
DESK_PORT=8443
DESK_ORIGIN=https://127.0.0.1:8443
DESK_TLS_CERT_PATH=
DESK_TLS_KEY_PATH=
DESK_OPERATOR_ALLOWLIST=
DESK_SQL_SERVER=
DESK_SQL_DATABASE=

# Optional existing L2 credentials. Empty values permit public observation.
# Presence is not authentication or account ownership; issue #16 implements probes.
POLYMARKET_API_KEY=
POLYMARKET_API_PASSPHRASE=
POLYMARKET_API_SECRET=
